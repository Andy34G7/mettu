<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="/pretty-feed-v3.xsl?v=4" type="text/xsl"?>
{% set root = (site.base_url | default('localhost', true) | string).strip().rstrip('/') %}
{% if '://' not in root %}{% set root = 'https://' ~ root %}{% endif %}
{% set bp = (site.base_path | default('', true) | string).strip().strip('/') %}
{% set base = root ~ ('/' ~ bp if bp else '') %}
<feed xmlns="http://www.w3.org/2005/Atom" xml:base="{{ base | e }}/">
  <title>{{ (feed_title | default(site.site_name, true)) | e }}</title>
  <subtitle>{{ (feed_subtitle | default('Posts from ' ~ site.author, true)) | e }}</subtitle>
  <link href="{{ (base ~ feed_self_url) | e }}" rel="self" type="application/atom+xml"/>
  <link href="{{ (base ~ (feed_alt_url | default('/', true))) | e }}" rel="alternate" type="text/html"/>
  <id>{{ (base ~ (feed_alt_url | default('/', true))) | e }}</id>
  <updated>{{ build_time | e }}</updated>
  <author>
    <name>{{ site.author | e }}</name>
  </author>

  {% for entry in feed_entries %}
  <entry>
    <title>{{ entry.title | e }}</title>
    <link href="{{ (base ~ entry.url) | e }}" rel="alternate" type="text/html"/>
    <id>{{ (base ~ entry.url) | e }}</id>
    <published>{{ entry.date_iso | e }}</published>
    <updated>{{ entry.date_iso | e }}</updated>
    {% if entry.tags %}
    {% for tag in entry.tags %}
    <category term="{{ tag | e }}"/>
    {% endfor %}
    {% endif %}
    {% if entry.description %}
    <summary type="text">{{ entry.description | e }}</summary>
    {% endif %}
    {% if entry.content_html %}
    <content type="html">{{ entry.content_html | e }}</content>
    {% endif %}
  </entry>
  {% endfor %}
</feed>
